{
  "name": "artemis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @artemis/api run start:dev",
    "dev:web": "npm --workspace @artemis/web run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm --workspace @artemis/api test",
    "test:e2e": "npm --workspace @artemis/api run test:e2e",
    "db:generate": "npm --workspace @artemis/api run db:generate",
    "db:migrate": "npm --workspace @artemis/api run db:migrate",
    "db:studio": "npm --workspace @artemis/api run db:studio",
    "db:generate:postgres": "npm --workspace @artemis/api run db:generate:postgres",
    "db:migrate:postgres": "npm --workspace @artemis/api run db:migrate:postgres",
    "db:studio:postgres": "npm --workspace @artemis/api run db:studio:postgres"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
